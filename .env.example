# hotel-finder configuration. Copy this file to `.env` and fill in the blanks.
#
# With NOTHING set, the agent runs fully offline: the mock provider + the heuristic
# scorer (deterministic, no network, $0). For REAL local evaluation, flip the two
# toggles marked [REAL EVAL] below and add your keys.

# --- Data providers -------------------------------------------------------------
# Comma-separated. "mock" = bundled fixtures (offline default). "liteapi" = real
# hotels, content, and prices. [REAL EVAL] set to: liteapi
ENABLED_PROVIDERS=mock

# LiteAPI: free sandbox key from https://dashboard.liteapi.travel (sand_ prefix).
# Sent as the X-API-Key header. Required when ENABLED_PROVIDERS includes liteapi.
LITEAPI_API_KEY=
# LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0

# --- Scorer ---------------------------------------------------------------------
# heuristic -> free, deterministic, offline (default).
# llm       -> real LLM scoring via the OpenAI-compatible endpoint below; falls
#              back to the heuristic on any error. [REAL EVAL] set to: llm
SCORER=heuristic

# --- LLM scorer: Nebius Token Factory (OpenAI-compatible) -----------------------
# The local-eval LLM path. Get a bearer key from your Nebius Token Factory console.
# LLM_BACKEND=openai forces this transport (auto also picks it when LLM_API_KEY is
# set and no NEBIUS_ENDPOINT_URL is present).
LLM_BACKEND=openai
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=
# A chat model id from your Nebius console. Token Factory has no qwen2.5-32b, so the
# closest to the orchestrator's serverless endpoint (dense 32B) is Qwen3-32B.
LLM_MODEL=Qwen/Qwen3-32B
# LLM_TIMEOUT=30
# Qwen3 defaults to a "thinking" pass that is slow and can break JSON; disabling it also
# matches the non-thinking qwen2.5-32b the orchestrator runs. No-op on non-thinking models.
LLM_DISABLE_THINKING=true

# Alternative free OpenAI-compatible provider (Groq): swap the two values above.
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile      # see https://console.groq.com/docs/models

# --- LLM scorer: shared Nebius serverless endpoint (orchestrator mode) ----------
# Ollama REST, no API key; the single served model is auto-discovered via
# {url}/api/tags. Leave blank for local eval. LLM_BACKEND=auto uses this transport
# whenever NEBIUS_ENDPOINT_URL is set.
# NEBIUS_ENDPOINT_URL=
# NEBIUS_ENDPOINT_TOKEN=
# NEBIUS_ENDPOINT_MODEL=

# --- Geocoding (free, keyless Nominatim; used for free-text Place resolution) ----
# GEOCODER_USER_AGENT=hotel-finder/0.1 (+https://github.com/MatanKoby/hotel-finder)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
