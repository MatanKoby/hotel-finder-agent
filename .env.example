# Which scorer the pipeline uses.
#   heuristic  -> free, deterministic, offline (default)
#   llm        -> calls an OpenAI-compatible endpoint (see below); falls back to heuristic on error
SCORER=heuristic

# LLM scorer config (only read when SCORER=llm). Any OpenAI-compatible endpoint works.
# Defaults target Groq's free tier; swap these three values for xAI Grok or OpenRouter.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Verify a current model id at https://console.groq.com/docs/models
LLM_MODEL=llama-3.3-70b-versatile

# --- LiteAPI (Milestone 1 data source: location + description + price) ---
# Free sandbox key from https://dashboard.liteapi.travel (sand_ prefix). Sent as X-API-Key.
LITEAPI_API_KEY=
# LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0

# --- Nebius LLM run modes (pick one; both are contacted by this repo itself) ---
# LLM_BACKEND=auto  # auto: endpoint if NEBIUS_ENDPOINT_URL set, else openai if LLM_API_KEY set,
#                   # else heuristic. Force with LLM_BACKEND=openai|endpoint.
#
# Mode A - eval/testing: OpenAI-compatible + API key (Nebius Token Factory, uncapped model):
#   SCORER=llm
#   LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
#   LLM_API_KEY=<your Nebius Token Factory bearer key>
#   LLM_MODEL=<a chat model id from your Nebius console>
#
# Mode B - orchestrator: shared Nebius serverless endpoint (Ollama REST, no API key):
#   SCORER=llm
#   NEBIUS_ENDPOINT_URL=<shared endpoint https url>
#   NEBIUS_ENDPOINT_TOKEN=<bearer token>
#   # model auto-discovered via {url}/api/tags; override with NEBIUS_ENDPOINT_MODEL=
